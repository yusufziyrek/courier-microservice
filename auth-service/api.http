@baseUrl = http://localhost:8081/api/v1/auth
@email = demo@example.com
@password = mysecret123
@fullName = Demo User

### 1. Kullanıcı Kaydı (Register)
# @name register
POST {{baseUrl}}/register
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}",
    "full_name": "{{fullName}}"
}

###

### 2. Giriş Yap (Login)
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}

###

# Login isteği sonrası dönen tokenları dinamik olarak VS Code değişkenlerine atıyoruz
@accessToken = {{login.response.body.access_token}}
@refreshToken = {{login.response.body.refresh_token}}

### 3. Profili Getir (Get Me - Protected)
GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}

###

### 4. Token Yenileme (Refresh)
# @name refresh
POST {{baseUrl}}/refresh
Content-Type: application/json

{
    "refresh_token": "{{refreshToken}}"
}

###

# Yenilenmiş Access Token'ı alıyoruz
@newAccessToken = {{refresh.response.body.access_token}}

### 5. Yeni Token ile Tekrar Profil Getir
GET {{baseUrl}}/me
Authorization: Bearer {{newAccessToken}}

###

### 6. Çıkış Yap (Logout)
POST {{baseUrl}}/logout
Content-Type: application/json

{
    "refresh_token": "{{refreshToken}}"
}
